<?xml version="1.0" ?>

<robot name="quadcopter">

    <properties
        arm="{{ arm }}"
        kf="3.16e-10"
        km="7.94e-12"
        thrust2weight="2.25"
        max_speed_kmh="30"
        gnd_eff_coeff="11.36859"
        prop_radius="{{ prop_radius }}"
        drag_coeff_xy="9.1785e-3"
        drag_coeff_z="10.311e-3"
        dw_coeff_1="276700.18"
        dw_coeff_2=".16"
        dw_coeff_3="-.11"
    />

    <material name="blue">
        <color rgba="0.0 0.0 1.0 1"/>
    </material>
    <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
    </material>
    <material name="yellow">
        <color rgba="1.0 1.0 0.0 1"/>
    </material>
    <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
    </material>

    <link name="base_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="{{ mass }}"/>
            <inertia ixx="{{ ixx }}" ixy="0" ixz="0" iyy="{{ iyy }}" iyz="0" izz="{{ izz }}"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="./body.obj" scale="{{ scale_x }} {{ scale_y }} {{ scale_z }}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 {{ box_origin_z }}"/>
            <geometry>
                <box size="{{ size_x }} {{ size_y }} {{ size_z }}"/>
            </geometry>
        </collision>
    </link>

    <link name="prop0_link">
        <inertial>
            <origin rpy="0 0 0" xyz="{{ arm }} 0.0 {{ prop_z }}"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="{{ arm }} 0.0 {{ prop_z }}"/>
            <geometry>
                <mesh filename="./prop.obj" scale="{{ prop_scale }} {{ prop_scale }} {{ prop_scale }}"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>
    <joint name="prop0_joint" type="fixed">
        <parent link="base_link"/>
        <child link="prop0_link"/>
    </joint>

    <link name="prop1_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0.0 -{{ arm }} {{ prop_z }}"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0.0 -{{ arm }} {{ prop_z }}"/>
            <geometry>
                <mesh filename="./prop.obj" scale="{{ prop_scale }} {{ prop_scale }} {{ prop_scale }}"/>
            </geometry>
            <material name="yellow"/>
        </visual>
    </link>
    <joint name="prop1_joint" type="fixed">
        <parent link="base_link"/>
        <child link="prop1_link"/>
    </joint>

    <link name="prop2_link">
        <inertial>
            <origin rpy="0 0 0" xyz="-{{ arm }} 0.0 {{ prop_z }}"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-{{ arm }} 0.0 {{ prop_z }}"/>
            <geometry>
                <mesh filename="./prop.obj" scale="{{ prop_scale }} {{ prop_scale }} {{ prop_scale }}"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>
    <joint name="prop2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="prop2_link"/>
    </joint>
    
    <link name="prop3_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0.0 {{ arm }} {{ prop_z }}"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0.0 {{ arm }} {{ prop_z }}"/>
            <geometry>
                <mesh filename="./prop.obj" scale="{{ prop_scale }} {{ prop_scale }} {{ prop_scale }}"/>
            </geometry>
            <material name="yellow"/>
        </visual>
    </link>
    <joint name="prop3_joint" type="fixed">
        <parent link="base_link"/>
        <child link="prop3_link"/>
    </joint>

</robot>
