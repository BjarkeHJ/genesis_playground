<?xml version="1.0"?>
<robot name="box">

  <properties> 
    mass="0.4" 
    size_x="0.2" 
    size_y="0.2" 
    size_z="0.05"
    drag_coeff_x="-0.006431250000000002" 
    drag_coeff_y="-0.006431250000000002" 
    drag_coeff_z="-0.02572500000000001"
    attachment_points="[[0.09000000000000001, 0.0], [-0.044999999999999984, 0.07794228634059949], [-0.04500000000000005, -0.07794228634059946]]"
  </properties>

  <material name="payload_body">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="payload_panel">
    <color rgba="0.9 0.0 0.0 1.0"/>
  </material>
  <material name="payload_arrow">
    <color rgba="0.05 0.85 0.05 1.0"/>
  </material>

  <link name="payload">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.001416666666666667" ixy="0" ixz="0" iyy="0.001416666666666667" iyz="0" izz="0.002666666666666667"/>
    </inertial>

    <visual name="body_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <material name="payload_body"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
    </collision>

    <!-- Top panel: background plate for the direction arrow -->
    <visual name="top_panel_visual">
      <origin xyz="0 0 0.027000000000000003" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.004"/>
      </geometry>
      <material name="payload_panel"/>
    </visual>

    <!-- Arrow shaft, pointing toward +x -->
    <visual name="arrow_shaft_visual">
      <origin xyz="-0.010499999999999999 0 0.034" rpy="0 0 0"/>
      <geometry>
        <box size="0.048999999999999995 0.0084 0.01"/>
      </geometry>
      <material name="payload_arrow"/>
    </visual>

    <!-- Arrow head: square box rotated 45 deg into a diamond, tip pointing toward +x -->
    <visual name="arrow_head_visual">
      <origin xyz="0.024499999999999997 0 0.034" rpy="0 0 0.785398"/>
      <geometry>
        <box size="0.020999999999999998 0.020999999999999998 0.01"/>
      </geometry>
      <material name="payload_arrow"/>
    </visual>

  </link>

  <link name="attach_0">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="payload_planel"/>
    </visual>
  </link>
  <joint name="attach_0_joint" type="fixed">
    <parent link="payload"/>
    <child link="attach_0"/>
    <origin xyz="0.09000000000000001 0.0 0.025" rpy="0 0 0"/>
  </joint>
  <link name="attach_1">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="payload_planel"/>
    </visual>
  </link>
  <joint name="attach_1_joint" type="fixed">
    <parent link="payload"/>
    <child link="attach_1"/>
    <origin xyz="-0.044999999999999984 0.07794228634059949 0.025" rpy="0 0 0"/>
  </joint>
  <link name="attach_2">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="payload_planel"/>
    </visual>
  </link>
  <joint name="attach_2_joint" type="fixed">
    <parent link="payload"/>
    <child link="attach_2"/>
    <origin xyz="-0.04500000000000005 -0.07794228634059946 0.025" rpy="0 0 0"/>
  </joint>

</robot>